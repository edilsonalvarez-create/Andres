# Copie este archivo como .env y complete los valores.
# SQL_SA_PASSWORD: solo la usan los servicios `sqlserver` (bootstrap), `migrate`
# (DDL) y `db-init` (crea el login de mínimo privilegio). El API NUNCA usa `sa`.
SQL_SA_PASSWORD=Cambiar.Password.Seguro1!
# Sprint 16-B: usuario de aplicación de mínimo privilegio (db_datareader +
# db_datawriter, sin permisos DDL) — ver database/00-app-user.sql. El servicio
# `api` se conecta con estas credenciales, no con SQL_SA_PASSWORD.
APP_DB_USER=qaguardian_app
APP_DB_PASSWORD=
JWT_SIGNING_KEY=genere-una-clave-aleatoria-de-al-menos-32-caracteres
ENCRYPTION_KEY=genere-otra-clave-aleatoria-para-cifrado-de-tokens
ANTHROPIC_API_KEY=
ADMIN_EMAIL=admin@qaguardian.local
# Obligatoria: genere una contraseña única (>=10 caracteres, mayúscula/minúscula/dígito).
# NUNCA use un valor documentado públicamente; el arranque falla si coincide con uno conocido.
ADMIN_PASSWORD=
ASPNETCORE_ENVIRONMENT=QA
# Sprint 16-A: el servicio compose `migrate` aplica EF; el API no hace Migrate en boot.
# Database__ApplyMigrationsOnStartup=false (forzado fuera de Development en Program.cs)
# Sprint 17-A (B1): el API ya NO monta /var/run/docker.sock. El acceso al daemon
# Docker pasa por el servicio `docker-socket-proxy` (allowlist de endpoints) en la
# red interna `docker-control`, vía DOCKER_HOST=tcp://docker-socket-proxy:2375.
# Por eso YA NO se necesita DOCKER_GID/group_add (era para el socket montado).
# El único servicio que monta el socket (solo lectura) es el proxy. Ver ADR-012.
# Sprint 16-B: sqlserver/redis NO publican puertos en docker-compose.yml (red
# interna). docker-compose.override.yml los publica solo para depuración local
# y se carga automático con `docker compose up`; en producción/CI use
# `docker compose -f docker-compose.yml up -d` (sin el override).
# Sprint 18-A (B2): allowlist de destinos SQL para entornos de BD por proyecto.
# Fuera de Development, lista vacia = denegar TODO destino SQL (fail-closed).
# Host exacto o comodin de sufijo. Un host listado se permite aunque sea IP privada.
# DatabaseValidation__AllowedSqlHosts__0=sqlserver
# DatabaseValidation__AllowedSqlHosts__1=*.db.miempresa.local
# Opcional Sprint 12: entornos BD nombrados vía config (preferible POST /api/v1/integrations/database-environments).
# ProjectDatabaseEnvironments__{projectGuid}__dev=Server=...;Database=...;User Id=...;Password=...;TrustServerCertificate=True
# ProjectDatabaseEnvironments__{projectGuid}__staging=Server=...;Database=...;User Id=...;Password=...;TrustServerCertificate=True
# Sprint 13 — sandbox de runners (compose). Dev local: UseSandbox=false en appsettings.Development.
# RUNNERS_USE_SANDBOX=true
# RUNNERS_SANDBOX_IMAGE=qaguardian/runner-newman:local
# RUNNERS_SANDBOX_IMAGE_PLAYWRIGHT=qaguardian/runner-playwright:local
# RUNNERS_SANDBOX_IMAGE_JMETER=qaguardian/runner-jmeter:local
# RUNNERS_SANDBOX_NETWORK=none
# Opcional: bridge solo si Newman/Playwright deben alcanzar APIs externas (sin allowlist aún).
# docker build -t qaguardian/runner-newman:local -f docker/runner-newman/Dockerfile docker/runner-newman
# docker build -t qaguardian/runner-playwright:local -f docker/runner-playwright/Dockerfile docker/runner-playwright
# docker build -t qaguardian/runner-jmeter:local -f docker/runner-jmeter/Dockerfile docker/runner-jmeter
