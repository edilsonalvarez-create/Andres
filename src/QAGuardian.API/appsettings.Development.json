{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=qaguardian-dev.db",
    "Redis": ""
  },
  "Database": {
    "UseSqlite": true,
    "ApplyMigrationsOnStartup": true
  },
  "Hangfire": {
    "UseInMemory": true
  },
  "Runners": {
    "UseSandbox": false
  },
  "Security": {
    "Ssrf": {
      "AllowHttpHosts": [ "localhost", "127.0.0.1" ],
      "AllowPrivateHosts": [ "localhost", "127.0.0.1" ]
    }
  },
  // Sprint 18-A (B2): lista vacia en Development = solo localhost/127.0.0.1 como destino SQL
  // (semantica documentada en SqlHostGuard). Agregue hosts internos aqui si los necesita en dev.
  "DatabaseValidation": {
    "AllowedSqlHosts": []
  },
  // Jwt:SigningKey, Security:EncryptionKey, Seed:AdminEmail y Seed:AdminPassword se configuran
  // con `dotnet user-secrets` (ver docs/Manual-Instalacion.md §2), no en este archivo versionado.
  // OWASP A05:2025 / A07:2025: ningún secreto —ni siquiera de desarrollo— debe vivir en git,
  // aunque esté claramente marcado como "no usar en producción": normaliza el hábito incorrecto
  // y un checkout accidental de este archivo en otro ambiente lo filtraría igual.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  }
}
