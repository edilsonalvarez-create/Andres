<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Piso de cobertura (gate de regresión): la CI falla si baja de este umbral.
         Sprint 16-C: piso honesto — línea real ~46% (2026-07-17); se deja margen de
         ~2pts para no romper por fluctuaciones menores. Subir a medida que crezca la suite. -->
    <Threshold>44</Threshold>
    <ThresholdType>line</ThresholdType>
    <ThresholdStat>total</ThresholdStat>
    <!-- Exclusiones de cobertura: código generado (migraciones EF, scaffolding del snapshot
         del modelo) no se prueba a mano — es artefacto de herramienta, no lógica de negocio. -->
    <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
    <Exclude>[*]QAGuardian.Infrastructure.Migrations.*</Exclude>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Domain se referencia explícitamente (además de transitivamente) para que Stryker.NET
         pueda mutarlo directamente; las pruebas de dominio ya usan sus tipos. -->
    <ProjectReference Include="..\..\src\QAGuardian.Domain\QAGuardian.Domain.csproj" />
    <ProjectReference Include="..\..\src\QAGuardian.Application\QAGuardian.Application.csproj" />
    <ProjectReference Include="..\..\src\QAGuardian.Infrastructure\QAGuardian.Infrastructure.csproj" />
  </ItemGroup>
</Project>
